# 本地构建签名环境模板（复制为 .env.local 后填入真实值）
# .env.local 已被 .gitignore 忽略，勿提交
# 生成密钥：npm run tauri -- signer generate -p 密码 -w ~/.tauri/fastenerTradeWorkbench-updater.key

# 更新产物签名私钥（Tauri updater）。路径指向本机 ~/.tauri/fastenerTradeWorkbench-updater.key
TAURI_SIGNING_PRIVATE_KEY_PATH="~/.tauri/fastenerTradeWorkbench-updater.key"
# 私钥密码（生成密钥时设置的密码）
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# 方式二（备用）：内联私钥内容——仅当第三方 CI 不支持 PATH 形式时启用：
# 1) 注释掉上面的 PATH 行  2) 取消下行注释并粘贴 ~/.tauri/fastenerTradeWorkbench-updater.key 全文
# export TAURI_SIGNING_PRIVATE_KEY="
# （密钥文件全文，含首行 untrusted comment）
# "
