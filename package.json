{
  "name": "fastener-trade-workbench",
  "version": "1.0.57",
  "private": true,
  "type": "module",
  "description": "紧固件贸易工作台 (Vue3 + Vite 开发，Tauri 桌面封装)",
  "scripts": {
    "dev": "vite",
    "vite:build": "vite build",
    "build": "npm run vite:build && npm run tauri:build && npm run make:dmg",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/with-updater-key.mjs tauri build",
    "gen:latest": "node scripts/gen-latest-json.mjs",
    "make:dmg": "bash scripts/make-dmg.sh",
    "icons": "tauri icon src/public/images/favicon.png",
    "version:set": "node scripts/bump-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "copy:frontend": "node scripts/copy-frontend.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5"
  }
}
